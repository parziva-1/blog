---
import PostView from "@/views/PostView.astro";
import { getPosts, slugOf } from "@/lib/posts";

export async function getStaticPaths() {
  return (await getPosts("es")).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<PostView post={post} />
