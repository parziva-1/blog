---
import CommentItem from "./CommentItem.astro";
import { COMMENTS } from "@/config/comments";
import { t, type Lang } from "@/i18n";
import { loadComments } from "@/lib/comments";
interface Props { translationKey: string; lang: Lang }
const { translationKey, lang } = Astro.props;
const s = t(lang).comments;
const list = await loadComments(translationKey, lang);
const enabled = Boolean(COMMENTS.repoId && COMMENTS.categoryId);
const giscus = enabled
  ? JSON.stringify({
      repo: COMMENTS.repo, repoId: COMMENTS.repoId, category: COMMENTS.category, categoryId: COMMENTS.categoryId,
      term: translationKey, lang,
    })
  : null;
---
<section class="comments" id="comments" aria-labelledby="comments-h">
  <h2 id="comments-h">{s.title} <small>{list.length}</small></h2>
  <p class="comments-empty" style="font-style:normal">{s.intro}</p>
  {list.length === 0 ? (
    <p class="comments-empty">{s.empty}</p>
  ) : (
    <ul class="comment-list">
      {list.map((c) => <CommentItem c={c} lang={lang} />)}
    </ul>
  )}
  {giscus ? (
    <div class="giscus-wrap" data-giscus={giscus}><p class="comments-empty">{s.loading}</p></div>
  ) : (
    <div class="giscus-wrap"><p class="comments-empty">{s.noGiscus}</p></div>
  )}
</section>
{giscus && (
  <script is:inline>
    (function () {
      var box = document.querySelector("[data-giscus]");
      if (!box) return;
      function load() {
        if (box.dataset.loaded) return;
        box.dataset.loaded = "1";
        var c = JSON.parse(box.dataset.giscus);
        var theme = window.__siteTheme ? window.__siteTheme() : "light";
        var s = document.createElement("script");
        s.src = "https://giscus.app/client.js";
        var a = {
          "data-repo": c.repo, "data-repo-id": c.repoId, "data-category": c.category, "data-category-id": c.categoryId,
          "data-mapping": "specific", "data-term": c.term, "data-strict": "0", "data-reactions-enabled": "1",
          "data-emit-metadata": "0", "data-input-position": "top", "data-theme": theme, "data-lang": c.lang,
          "data-loading": "lazy", crossorigin: "anonymous"
        };
        for (var k in a) s.setAttribute(k, a[k]);
        s.async = true;
        box.innerHTML = "";
        box.appendChild(s);
      }
      if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (e) {
          if (e[0].isIntersecting) { io.disconnect(); load(); }
        }, { rootMargin: "400px" });
        io.observe(box);
      } else load();
    })();
  </script>
)}
